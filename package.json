{
  "name": "electronics-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:content": "vitest run tests/content.test.ts",
    "images:optimise": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
